# Root env for `docker compose` (optional). Copy to `.env` in this directory to
# override defaults. Compose also interpolates these when building/running.

# Published host port → API container :3000
API_PORT=3000

# Published host port → web container :8080 (nginx)
WEB_PORT=8080

# Browser-reachable API origin (no path suffix). Must match how the host maps
# API_PORT (e.g. http://localhost:3000).
VITE_API_BASE_URL=http://localhost:3000

# Browser origin of the SPA — must match WEB_PORT for local compose.
CORS_ORIGIN=http://localhost:8080

# API log level (Pino → stdout/stderr for `docker compose logs api`)
LOG_LEVEL=info
