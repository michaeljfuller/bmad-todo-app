# Fastify reads env from this directory.

PORT=3000
DATABASE_PATH=./data/todos.db
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
NODE_ENV=development

# --- Docker Compose (repo root `docker-compose.yml`) ---
# Use an absolute DB path on the mounted volume, e.g. DATABASE_PATH=/data/todos.db.
# Set CORS_ORIGIN to the browser origin of the web service (e.g. http://localhost:8080),
# not the internal Docker hostname. Defaults for compose live in root `.env.example`.
